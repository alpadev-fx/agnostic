#!/bin/bash
# agnostic — top-level CLI wrapper.
#
# Usage:
#   agnostic init [TARGET_DIR]     # install into target (default: cwd)
#   agnostic detect [TARGET_DIR]   # print detected stacks
#   agnostic update [TARGET_DIR]   # refresh framework files (overwrite)
#   agnostic help

set -e
FW_ROOT="$(cd "$(dirname "$0")" && pwd)"

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)
    # Default: interactive wizard. Skip with --non-interactive.
    NON_INTERACTIVE=0
    NEW_ARGS=()
    for a in "$@"; do
      case "$a" in
        --non-interactive) NON_INTERACTIVE=1 ;;
        *)                 NEW_ARGS+=("$a") ;;
      esac
    done
    # Auto-detect non-interactive if stdin is not a TTY
    [ ! -t 0 ] && NON_INTERACTIVE=1
    if [ "$NON_INTERACTIVE" = "1" ]; then
      exec "$FW_ROOT/bootstrap/install.sh" "${NEW_ARGS[@]}"
    else
      exec "$FW_ROOT/bootstrap/wizard.sh" "${NEW_ARGS[@]}"
    fi
    ;;
  detect)
    exec "$FW_ROOT/bootstrap/detect-stack.sh" --dir="${1:-$PWD}"
    ;;
  update)
    # Update = force overwrite, non-interactive
    exec "$FW_ROOT/bootstrap/install.sh" "${1:-$PWD}" --force
    ;;
  help|--help|-h)
    cat <<EOF
agnostic — opinionated Claude Code framework

Commands:
  init [DIR] [flags]   Interactive setup (default). Asks questions, then installs.
  detect [DIR]         Print stacks detected in DIR
  update [DIR]         Alias for: init --force --non-interactive (refresh everything)
  help                 Show this message

init flags:
  --non-interactive    Skip wizard; use heuristic defaults + TODOs (CI-friendly)
  --force              Also overwrite user files (CLAUDE.md, agnostic.toml, settings.local.json)
  --no-overwrite       Skip existing framework files (idempotent mode)
  --no-backup          Don't back up existing .claude/ to .claude.bak.<timestamp>
  --dry-run            Show what would happen; write nothing

Wizard collects (skip with --non-interactive):
  Project: name, description, stack summary
  Verify:  per-file lint, typecheck, lint, test commands
  Integrations: GitHub repo, Linear team, Slack channels
  Content: build commands, hard rules, architecture pointers
  Optional: commit to git after install

Default behavior:
  Overwrites framework files: .claude/{hooks,agents,commands,rules,settings.json}, CLAUDE.md
  Preserves user files:       agnostic.toml, .claude/settings.local.json, memory/*.md
  Backs up existing .claude/  to .claude.bak.<timestamp>
  Backs up existing CLAUDE.md to CLAUDE.md.bak.<timestamp>

Full install guide: see INSTALL.md in the framework root.
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'agnostic help' for usage." >&2
    exit 1
    ;;
esac
