#!/bin/bash
# agnostic — top-level CLI wrapper.
#
# Usage:
#   agnostic init [TARGET_DIR]     # discover answers from project files, install
#   agnostic detect [TARGET_DIR]   # print detected stacks
#   agnostic update [TARGET_DIR]   # refresh framework files (force overwrite)
#   agnostic help

set -e

# Resolve symlink chain so the CLI works when installed via `ln -s`
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
FW_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)
    # Auto-discover from project files, then install. No prompts.
    # Edit CLAUDE.md / agnostic.toml after if any field needs refinement.
    SKIP_PLUGINS=0
    POSITIONAL=()
    for a in "$@"; do
      case "$a" in
        --skip-plugins) SKIP_PLUGINS=1 ;;
        *)              POSITIONAL+=("$a") ;;
      esac
    done
    set -- "${POSITIONAL[@]}"

    TARGET="${1:-$PWD}"
    NEW_ARGS=("$@")

    # Install recommended plugins + MCPs (global to user)
    if [ "$SKIP_PLUGINS" != "1" ]; then
      "$FW_ROOT/bootstrap/install-plugins.sh"
      echo
    fi

    echo "agnostic init"
    echo "  Discovering project answers from files..."
    eval "$("$FW_ROOT/bootstrap/discover.sh" "$TARGET")"
    export AGNOSTIC_PROJECT_NAME AGNOSTIC_DESCRIPTION AGNOSTIC_STACK_SUMMARY \
           AGNOSTIC_BUILD_COMMANDS AGNOSTIC_HARD_RULES AGNOSTIC_ARCH_POINTERS \
           AGNOSTIC_LINT_FILE_CMD AGNOSTIC_TYPECHECK_CMD AGNOSTIC_LINT_CMD \
           AGNOSTIC_TEST_CMD AGNOSTIC_GITHUB_REPO AGNOSTIC_LINEAR_TEAM
    echo "  Discovered:"
    echo "    Project:        ${AGNOSTIC_PROJECT_NAME:-?}"
    echo "    Stack:          ${AGNOSTIC_STACK_SUMMARY:-?}"
    echo "    GitHub repo:    ${AGNOSTIC_GITHUB_REPO:-(none)}"
    echo "    Linear team:    ${AGNOSTIC_LINEAR_TEAM:-(none)}"
    echo "    Lint cmd:       ${AGNOSTIC_LINT_CMD:-?}"
    echo "    Test cmd:       ${AGNOSTIC_TEST_CMD:-?}"
    echo
    exec "$FW_ROOT/bootstrap/install.sh" "${NEW_ARGS[@]}"
    ;;
  detect)
    exec "$FW_ROOT/bootstrap/detect-stack.sh" --dir="${1:-$PWD}"
    ;;
  update)
    exec "$FW_ROOT/bootstrap/install.sh" "${1:-$PWD}" --force
    ;;
  help|--help|-h)
    cat <<EOF
agnostic — opinionated Claude Code framework

Commands:
  init [DIR] [flags]   Discover project answers, then install
  detect [DIR]         Print stacks detected in DIR
  update [DIR]         Alias for: init --force (overwrite user files too)
  help                 Show this message

init flags:
  --force              Also overwrite agnostic.toml, settings.local.json, memory/
  --no-overwrite       Skip files that already exist (idempotent)
  --backup             Move wiped config to .claude.bak.<timestamp>/ instead of deleting
  --skip-plugins       Skip plugin + MCP install (default: install all recommended)
  --dry-run            Show what would happen, write nothing

Recommended plugins (auto-installed to ~/.claude/settings.json):
  gopls-lsp@claude-plugins-official       Go LSP
  claude-mem@thedotmack                    persistent memory across sessions
  playwright@claude-plugins-official       browser MCP
  atomic-agents@claude-plugins-official    small focused agent pattern
  frontend-design@claude-plugins-official  UI design helpers
  caveman@caveman                          terse mode
  headroom@headroom-marketplace            startup hooks / context savings

Recommended MCPs (auto-added via claude mcp add):
  stitch                                   Google design tool

Auto-discovery sources:
  README.md          → description
  Makefile / scripts → build + lint/test commands
  go.mod / etc.      → stack summary with versions
  CLAUDE.md.bak.*    → hard rules (preserved across re-install)
  git remote/branch  → GitHub repo + Linear team
  ~/.claude/         → expected plugins + marketplaces

Default behavior (destructive — use --backup to keep prior config):
  Wipes:     .claude/, CLAUDE.md, agent-md.toml, AGENTS.md, .codex/, etc.
  Installs:  CLAUDE.md (root) + .claude/{hooks,agents,commands,rules,...}
  Preserves: .claude/settings.local.json, .githooks/, .gemini/

Full guide: INSTALL.md in the framework root.
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'agnostic help' for usage." >&2
    exit 1
    ;;
esac
