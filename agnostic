#!/bin/bash
# agnostic — top-level CLI wrapper.
#
# Usage:
#   agnostic init [TARGET_DIR]     # discover answers from project files, install
#   agnostic detect [TARGET_DIR]   # print detected stacks
#   agnostic update [TARGET_DIR]   # refresh framework files (force overwrite)
#   agnostic help

set -e

# Resolve symlink chain so the CLI works when installed via `ln -s`
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
FW_ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

cmd="${1:-help}"
shift || true

case "$cmd" in
  init)
    # Auto-discover from project files, then install. No prompts.
    # Edit CLAUDE.md / agnostic.toml after if any field needs refinement.
    TARGET="${1:-$PWD}"
    NEW_ARGS=("$@")
    echo "agnostic init"
    echo "  Discovering project answers from files..."
    eval "$("$FW_ROOT/bootstrap/discover.sh" "$TARGET")"
    export AGNOSTIC_PROJECT_NAME AGNOSTIC_DESCRIPTION AGNOSTIC_STACK_SUMMARY \
           AGNOSTIC_BUILD_COMMANDS AGNOSTIC_HARD_RULES AGNOSTIC_ARCH_POINTERS \
           AGNOSTIC_LINT_FILE_CMD AGNOSTIC_TYPECHECK_CMD AGNOSTIC_LINT_CMD \
           AGNOSTIC_TEST_CMD AGNOSTIC_GITHUB_REPO AGNOSTIC_LINEAR_TEAM
    echo "  Discovered:"
    echo "    Project:        ${AGNOSTIC_PROJECT_NAME:-?}"
    echo "    Stack:          ${AGNOSTIC_STACK_SUMMARY:-?}"
    echo "    GitHub repo:    ${AGNOSTIC_GITHUB_REPO:-(none)}"
    echo "    Linear team:    ${AGNOSTIC_LINEAR_TEAM:-(none)}"
    echo "    Lint cmd:       ${AGNOSTIC_LINT_CMD:-?}"
    echo "    Test cmd:       ${AGNOSTIC_TEST_CMD:-?}"
    echo
    exec "$FW_ROOT/bootstrap/install.sh" "${NEW_ARGS[@]}"
    ;;
  detect)
    exec "$FW_ROOT/bootstrap/detect-stack.sh" --dir="${1:-$PWD}"
    ;;
  update)
    exec "$FW_ROOT/bootstrap/install.sh" "${1:-$PWD}" --force
    ;;
  help|--help|-h)
    cat <<EOF
agnostic — opinionated Claude Code framework

Commands:
  init [DIR] [flags]   Auto-discover project answers, then install
  detect [DIR]         Print stacks detected in DIR
  update [DIR]         Alias for: init --force (force overwrite of user files)
  help                 Show this message

init flags:
  --force              Also overwrite user files (CLAUDE.md, agnostic.toml, settings.local.json)
  --no-overwrite       Skip existing framework files (idempotent)
  --no-backup          Don't back up existing .claude/ or CLAUDE.md
  --dry-run            Show what would happen; write nothing

Auto-discovery sources:
  README.md          → one-line description
  Makefile / scripts → build commands + lint/test
  go.mod / etc.      → stack summary with versions (monorepo-aware)
  CLAUDE.md.bak.*    → hard rules (preserved across re-install)
  git remote/branch  → GitHub repo + Linear team
  ~/.claude/         → plugins + marketplaces expected

Default behavior:
  Overwrites framework files: .claude/{hooks,agents,commands,rules,settings.json}, CLAUDE.md
  Preserves user files:       agnostic.toml, .claude/settings.local.json, memory/*.md
  Backs up existing .claude/  to .claude.bak.<timestamp>
  Backs up existing CLAUDE.md to CLAUDE.md.bak.<timestamp>

Full install guide: see INSTALL.md in the framework root.
EOF
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    echo "Run 'agnostic help' for usage." >&2
    exit 1
    ;;
esac
